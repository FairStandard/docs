          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "case_relationship": {
            "title": "Case Relationship",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "case_id",
          "user_id",
          "case_relationship"
        ],
        "title": "CaseTeamMember",
        "type": "object"
      },
      "CaseTeamMemberIn": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "case_relationship": {
            "title": "Case Relationship",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "case_id",
          "user_id",
          "case_relationship"
        ],
        "title": "CaseTeamMemberIn",
        "type": "object"
      },
