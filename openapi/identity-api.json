      "MemberIn": {
        "properties": {
          "org_role": {
            "title": "Org Role",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "org_role"
        ],
        "title": "MemberIn",
        "type": "object"
      },
      "Membership": {
        "description": "One account's standing in one organization. `org_role` is a plain\nstring validated against the OrgRole registry at write time \u2014 never a\nCHECK constraint (ADR 0003). N:M: the same user_id can appear in many\nmemberships across different organizations.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "invited_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invited At"
          },
          "joined_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joined At"
          },
          "org_id": {
            "title": "Org Id",
            "type": "integer"
          },
          "org_role": {
            "title": "Org Role",
            "type": "string"
          },
          "removed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Removed At"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "org_id",
          "user_id",
          "org_role"
        ],
        "title": "Membership",
        "type": "object"
      },
