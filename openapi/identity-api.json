          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
