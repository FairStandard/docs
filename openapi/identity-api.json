        "description": "What other services are told about one membership: which org, and\nthe org role on it \u2014 never the invite/join/remove timestamps, which\nare identity-api's own bookkeeping, not a fact other services need.",
        "properties": {
          "org_id": {
            "title": "Org Id",
            "type": "integer"
          },
          "org_role": {
            "title": "Org Role",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "org_role"
        ],
        "title": "MembershipOut",
        "type": "object"
      },
      "Organization": {
        "description": "The paying customer, always (ADR 0001). `pro_bono` changes billing\ntreatment, never what the org can do or how its members are modeled.",
        "properties": {
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "jurisdiction_county": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction County"
          },
          "jurisdiction_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction State"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pro_bono": {
            "default": false,
            "title": "Pro Bono",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "created_at"
        ],
        "title": "Organization",
        "type": "object"
      },
      "OrganizationIn": {
        "properties": {
