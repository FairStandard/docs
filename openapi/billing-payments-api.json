    "/billing-cycle/run": {
      "post": {
        "description": "The billing-cycle door: no scheduler lives in this service; an\nexternal cron calls this on a cadence. Gated by the configured\nX-Cycle-Token (ADR 0007) and always running at the server's own\nclock \u2014 this door crosses every workspace and moves money state, so\nno caller gets to pick who it runs for or what time it is.",
        "operationId": "run_billing_cycle_billing_cycle_run_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Cycle-Token",
            "required": true,
            "schema": {
              "title": "X-Cycle-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Run Billing Cycle Billing Cycle Run Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Billing Cycle"
      }
    },
