  "rules": {
    "title_case": "sentence, except product nouns",
    "product_nouns": [
      "Vero",
      "FairStandard",
      "Case",
      "Deadline",
      "Record",
      "Finding",
      "Phase",
      "Records Index",
      "Learning Center",
      "Marketplace",
      "Next Steps"
    ],
    "opening": "the first body element is a prose paragraph",
    "forbidden_in_prose": [
      "!",
      "oops",
      "Whoops",
      "seamless",
      "powerful",
      "robust",
      "cutting-edge",
      "leverage",
      "unlock",
      "supercharge"
    ],
    "images": false,
    "service_names_forbidden_for": [
      "litigants",
      "attorneys"
    ],
    "service_name_pattern": "\\b[a-z]+(?:-[a-z]+)*-api\\b|\\bservicekit\\b",
    "advice_line_required_when": "frontmatter advice: true, or the section has advice_required, or the page is about what a court does",
    "keyword": {
      "class": "kw",
      "per_page": 1,
      "where": "the opening paragraph, or the first heading when the opening has no single word that carries the page",
      "why": "the same device as the italic blue r in the Vero wordmark: the one word that carries the idea of the page, never decoration",
      "markup": "<span className=\"kw\">word</span>"
    }
  },
